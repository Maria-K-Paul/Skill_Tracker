# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/skill_leveling_db

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Secret Code Encryption ────────────────────────────────────────────────────
# Fernet key (32-byte base64-encoded). Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CODE_ENCRYPTION_KEY=change-me-to-a-fernet-key

# ── LLM / AI Engine ───────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
